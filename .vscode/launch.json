{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "webapp",
            "type": "debugpy",
            "request": "attach",
            "django": true,
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "/webapp"
