#, python-format
msgid ""
"... to archive the wish named <strong>%(item_name)s</strong> on wish list "
"<strong>%(list_name)s</strong>?"
msgstr ""
"... daß du den Wunsch <strong>%(item_name)s</strong> auf dem Wunschzettel "
"<strong>%(list_name)s</strong> archivieren möchtest?"

msgid "This wish can not be archived."
msgstr "Dieser Wunsch kann nicht archiviert werden."

msgid "Archive your Wish"
msgstr "Wunsch archivieren"

msgid "Archive Wish"
msgstr "Wunsch archivieren"

msgid "Your wish has been successfully archived."
msgstr "Dein Wunsch wurde erfolgreich archiviert."

#, python-format
msgid ""
"... you want to <span class=\"text-danger\">delete</span> the wish named "
"<strong>%(item_name)s</strong> from list <strong>%(list_name)s</strong>?"
msgstr ""
"... daß du den Wunsch <strong>%(item_name)s</strong> vom Wunschzettel "
"<strong>%(list_name)s</strong> <span class=\"text-danger\">löschen</span> "
"möchtest?"

msgid "Delete a Wish"
msgstr "Wunsch löschen"

msgid "Delete Wish"
msgstr "Wunsch löschen"

msgid "Your wish has been successfully deleted."
msgstr "Dein Wunsch wurde erfolgreich gelöscht."

msgid "Description can be formatted using <strong>markdown</strong>."
msgstr "Beschreibung kann mit <strong>markdown</strong> formattiert werden."

msgid "Optional external URL for this wish."
msgstr "Optionale, externe URL für diesen Wunsch."

msgid "Optional external URL for this wish’s photo."
msgstr "Optionale, externe URL für ein Foto diesen Wunsches."

msgid "Enter wish’s name"
msgstr "Name des Wunsches eingeben"

msgid "Description"
msgstr "Beschreibung"

msgid "Enter wish’s description"
msgstr "Beschreibung des Wunsches eingeben"

msgid "Preference"
msgstr "Präferenz"

