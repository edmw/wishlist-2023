# Webapp’s configuration secrets.
# Actual secrets are encrypted using the webapp’s master key.
#
# To encrypt:
# cryptography.fernet.Fernet(master_key).encrypt(secret.encode("ascii"))
# This variables must either
# - contain valid values or
# - be overwritten by variables from a private environment
# (see FAQ#2 or Makefile on how to do it).

AUTH_GOOGLE_SECRET="..."
EMAIL_SMTP_PASSWORD="..."
PUSHOVER_APPLICATION_TOKEN="..."
STORAGE_SECRET_KEY="..."
DATABASE_PASSWORD="..."
