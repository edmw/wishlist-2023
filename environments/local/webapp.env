# Webapp’s configuration values.
#
# This variables must either
# - contain valid values or
# - be overwritten by variables from a private environment
# (see FAQ#2 or Makefile on how to do it).

# webapp
WEBAPP_ENVIRONMENT="development"
WEBAPP_SCHEME="http"
WEBAPP_HOST="localhost:13131"
WEBAPP_MEDIA_HOST="localhost:13131"
WEBAPP_MEDIA_PATH="/media/wishlist"
WEBAPP_ADMIN_SITE_ENABLED=True
ALLOWED_HOST="localhost"
SECRET_KEY="22e6ae1e9e78" # arbitrary random value not suitable for production
# authorization
AUTH_GOOGLE_CLIENT_ID="auth_google_client_id"
# messaging
EMAIL_SMTP_HOSTNAME="email_smtp_hostname"
EMAIL_SMTP_USERNAME="email_smtp_username"
EMAIL_SENDER_ADDRESS="email_sender_address"
EMAIL_SENDER_NAME="Wishlist"
PUSHOVER_SERVICE_URL="https://api.pushover.net/"
PUSHOVER_CONNECT_TIMEOUT_MS=3000
PUSHOVER_READ_TIMEOUT_MS=1000
# backends
STORAGE_URL="http://files:8333/"
STORAGE_ACCESS_KEY="f94050237bfd" # arbitrary random value not suitable for production
STORAGE_BUCKET_FILES="wishlist"
DATABASE_HOST="database"
CACHE_BACKEND="django.core.cache.backends.redis.RedisCache"
CACHE_LOCATION="redis://datastore:6379/1"
CACHE_KEY_PREFIX="de.yamanote.wl-local"
CELERY_BROKER_URL="redis://datastore:6379"
CELERY_TASK_QUEUE="de.yamanote.wl-local"
EMAIL_BACKEND="django.core.mail.backends.smtp.EmailBackend"

CORE_CONTACT_NAME="Max Mustermann"
CORE_CONTACT_ADDRESS="Musterstraße 1, 12345 Musterstadt, Musterland"
CORE_CONTACT_EMAIL="max@mustermann.de"
CORE_CONTACT_PHONE="+00-123/456789"
